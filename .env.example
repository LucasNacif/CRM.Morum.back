# Postgres local (docker compose up -d) o la URL de Neon en producción
DATABASE_URL="postgresql://morum:morum@localhost:5433/morum_stock"

# Cadena larga y aleatoria. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-un-secreto-largo"
JWT_EXPIRES_IN="30d"

# Origen del frontend permitido por CORS (separar varios con coma)
CORS_ORIGIN="http://localhost:5173"

PORT=3000

# Usuario que crea el seed (pnpm db:seed)
ADMIN_EMAIL="admin@morum.local"
ADMIN_PASSWORD="cambiar-esta-clave"
ADMIN_NAME="Morum"

# Fotos de productos en Cloudflare R2. En local se usa S3Mock (docker compose) con R2_ENDPOINT.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="morum-fotos"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
# Solo en desarrollo, para usar S3Mock en lugar de R2:
# R2_ENDPOINT="http://localhost:9090"
