generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INITIAL
  // Ya no se generan: quedan de cuando existían las compras.
  PURCHASE
  RESTOCK
  SALE
  SALE_CANCEL
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum Delivery {
  DELIVERED
  // Pagó una seña y la prenda queda apartada hasta que complete el pago.
  RESERVED
}

/// Cada emprendimiento (Morum, Clarus). Sus datos están totalmente separados.
model Business {
  id                 String   @id
  name               String
  // Última venta numerada: cada negocio lleva su propia numeración.
  lastSaleNumber     Int      @default(0)
  lastPurchaseNumber Int      @default(0)
  createdAt          DateTime @default(now())

  settings   Settings?
  categories Category[]
  products   Product[]
  sales      Sale[]
  purchases  Purchase[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements StockMovement[]
  sales     Sale[]
  payments  Payment[]
  purchases Purchase[]
}

model Settings {
  businessId    String   @id
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Porcentaje sobre el costo para sugerir el precio de venta.
  markupPercent Decimal  @default(100) @db.Decimal(7, 2)
  // Múltiplo al que se redondean los precios sugeridos (0 = sin redondeo).
  roundTo       Int      @default(0)
  // Con cuántos días de anticipación avisar un saldo por cobrar.
  dueAlertDays  Int      @default(3)
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([businessId, name])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  brand       String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  // Reservado para el catálogo público: solo se exhiben los publicados.
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   Variant[]

  @@index([businessId, name])
  @@index([categoryId])
}

model Variant {
  id        String   @id @default(uuid())
  size      String
  color     String
  // Único entre los dos negocios: una etiqueta nunca puede confundirse.
  barcode   String   @unique
  cost      Decimal  @default(0) @db.Decimal(12, 2)
  price     Decimal  @default(0) @db.Decimal(12, 2)
  // Cache del saldo: solo se modifica junto con un StockMovement, en la misma transacción.
  stock     Int      @default(0)
  minStock  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model StockMovement {
  id         String       @id @default(uuid())
  type       MovementType
  // Con signo: positivo entra, negativo sale.
  quantity   Int
  stockAfter Int
  note       String?
  createdAt  DateTime     @default(now())

  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([variantId, createdAt])
  @@index([createdAt])
}

model Sale {
  id            String        @id @default(uuid())
  number        Int
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  // Suma de los pagos recibidos. Si es menor al total, la venta tiene saldo por cobrar.
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  // Fecha acordada para cobrar el saldo.
  dueDate       DateTime?
  delivery      Delivery      @default(DELIVERED)
  // Medio del pago hecho al momento de la venta.
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  customerName  String?
  customerPhone String?
  note          String?
  cancelledAt   DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  items     SaleItem[]
  payments  Payment[]
  movements StockMovement[]

  @@unique([businessId, number])
  @@index([businessId, date])
  @@index([businessId, dueDate])
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  // Costo al momento de la venta, para calcular margen aunque el costo cambie después.
  unitCost  Decimal @db.Decimal(12, 2)

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

/// Cada pago de una venta: el del momento (total o seña) y los que completan el saldo.
model Payment {
  id        String        @id @default(uuid())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([saleId])
}

/// Ingreso de mercadería: prendas (nuevas o repuestas) y gastos sueltos como bolsas o percheros.
model Purchase {
  id            String   @id @default(uuid())
  number        Int
  date          DateTime @default(now())
  supplier      String?
  note          String?
  // Totales que se reparten en partes iguales entre las prendas de la compra.
  shippingCost  Decimal  @default(0) @db.Decimal(12, 2)
  packagingCost Decimal  @default(0) @db.Decimal(12, 2)
  // Ganancia general con la que se sugirieron los precios.
  markupPercent Decimal  @default(0) @db.Decimal(7, 2)
  productsTotal Decimal  @default(0) @db.Decimal(12, 2)
  expensesTotal Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  items     PurchaseItem[]
  expenses  PurchaseExpense[]
  movements StockMovement[]

  @@unique([businessId, number])
  @@index([businessId, date])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  quantity   Int
  // Lo pagado al proveedor por unidad.
  unitCost   Decimal @db.Decimal(12, 2)
  // Costo por unidad con el envío y el packaging repartidos: es el que queda en la prenda.
  landedCost Decimal @db.Decimal(12, 2)
  // Precio de venta que quedó asignado con esta compra.
  price      Decimal @db.Decimal(12, 2)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

/// Gasto de una compra que no es mercadería para vender (bolsas, percheros...). No tiene stock.
model PurchaseExpense {
  id          String  @id @default(uuid())
  description String
  amount      Decimal @db.Decimal(12, 2)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}
