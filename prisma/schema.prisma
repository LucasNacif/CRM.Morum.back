generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INITIAL
  PURCHASE
  SALE
  SALE_CANCEL
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  movements StockMovement[]
  sales     Sale[]
  purchases Purchase[]
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  brand       String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  // Reservado para el catálogo público: solo se exhiben los publicados.
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   Variant[]

  @@index([name])
  @@index([categoryId])
}

model Variant {
  id       String  @id @default(uuid())
  size     String
  color    String
  sku      String  @unique
  barcode  String  @unique
  cost     Decimal @default(0) @db.Decimal(12, 2)
  price    Decimal @default(0) @db.Decimal(12, 2)
  // Cache del saldo: solo se modifica junto con un StockMovement, en la misma transacción.
  stock    Int     @default(0)
  minStock Int     @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model StockMovement {
  id         String       @id @default(uuid())
  type       MovementType
  // Con signo: positivo entra, negativo sale.
  quantity   Int
  stockAfter Int
  note       String?
  createdAt  DateTime     @default(now())

  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([variantId, createdAt])
  @@index([createdAt])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id        String   @id @default(uuid())
  number    Int      @unique @default(autoincrement())
  date      DateTime @default(now())
  total     Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  items     PurchaseItem[]
  movements StockMovement[]

  @@index([date])
}

model PurchaseItem {
  id       String  @id @default(uuid())
  quantity Int
  unitCost Decimal @db.Decimal(12, 2)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

model Sale {
  id            String        @id @default(uuid())
  number        Int           @unique @default(autoincrement())
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  customerName  String?
  note          String?
  cancelledAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items     SaleItem[]
  movements StockMovement[]

  @@index([date])
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  // Costo al momento de la venta, para calcular margen aunque el costo cambie después.
  unitCost  Decimal @db.Decimal(12, 2)

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleId])
}
